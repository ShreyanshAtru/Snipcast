# setup.sh creates real local secrets. Never commit .env.
APP_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:8787
MEDIA_ROOT=/Users/shreyanshjain
REDIS_URL=redis://127.0.0.1:6381/0
POSTIZ_MODE=demo
POSTIZ_BASE_URL=http://127.0.0.1:4007/api/public/v1
POSTIZ_API_KEY=
MAX_CLIPS=500

# 4 seconds matches the bundled local Postiz API_LIMIT=1000.
# For an existing instance limited to 30/hour, use at least 125.
POSTIZ_MIN_INTERVAL_SECONDS=4
